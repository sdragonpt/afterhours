{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "NITRO_PRESET=static npm run generate",
  "outputDirectory": ".output/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/cal/:token/:event", "destination": "/api/cal?token=:token&event=:event" },
    { "source": "/cal/:token", "destination": "/api/cal?token=:token" },
    { "source": "/((?!api/|_nuxt/).*)", "destination": "/200.html" }
  ],
  "headers": [
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/_nuxt/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
